* ----------------------------------------------------------------- comparators
* open collector output to the negative supply, about 300 ns
.subckt COMPARATOR_OC inp inn vcc vee out
Rin inp inn 10Meg
Bc ctl 0 V = 0.5*(1-tanh(V(inp,inn)*2000))
Rc ctl ctl2 1k
Cc ctl2 0 300p
Sout out vee ctl2 0 SWOC
Rq vcc vee 10k
.model SWOC SW(Ron=20 Roff=1G Vt=0.5 Vh=0.05)
.ends COMPARATOR_OC
.subckt LM393 inp inn vcc vee out
X1 inp inn vcc vee out COMPARATOR_OC
.ends LM393
.subckt LM339 inp inn vcc vee out
X1 inp inn vcc vee out COMPARATOR_OC
.ends LM339
.subckt LM311 inp inn vcc vee out
X1 inp inn vcc vee out COMPARATOR_OC
.ends LM311
.subckt LM2903 inp inn vcc vee out
X1 inp inn vcc vee out COMPARATOR_OC
.ends LM2903

* ------------------------------------------------------------------ regulators
.subckt REG_LINEAR in gnd out params: vout=5 dropout=2
Breg o1 gnd V = max(min({vout}, V(in,gnd)-{dropout}), 0)
Rout o1 out 50m
Rq in gnd 100k
.ends REG_LINEAR

* ------------------------------------------------------------------- 555 timer
* pins: VCC GND TRIG THR DIS CV RESET OUT; trigger wins over threshold, reset over both
.subckt NE555 vcc gnd trig thr dis cv rst out
R1 vcc cv 5k
R2 cv lo 5k
R3 lo gnd 5k
Bs s 0 V = 0.5*(1+tanh((V(lo)-V(trig))*400))
Br r 0 V = 0.5*(1+tanh((V(thr)-V(cv))*400))
Brr rr 0 V = 0.5*(1-tanh((V(rst,gnd)-0.7)*40))
Bq qn 0 V = V(rr) > 0.5 ? 0 : (V(s) > 0.5 ? 1 : (V(r) > 0.5 ? 0 : V(q)))
Rq qn q 1k
Cq q 0 20p
Bout o1 gnd V = V(q)*max(V(vcc,gnd)-1.7, 0) + (1-V(q))*0.1
Rout o1 out 10
Bqd qd 0 V = 1-V(q)
Sdis dis gnd qd 0 SWDIS
Rsup vcc gnd 1.5k
.model SWDIS SW(Ron=10 Roff=1G Vt=0.5 Vh=0.05)
.ends NE555
.subckt LM555 vcc gnd trig thr dis cv rst out
X1 vcc gnd trig thr dis cv rst out NE555
.ends LM555
